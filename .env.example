# LLM provider (Step 4+)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL (Step 6+)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/auditor

# App settings (optional overrides; defaults come from configs/default.yaml)
# LOG_LEVEL=DEBUG
